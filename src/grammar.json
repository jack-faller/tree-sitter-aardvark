{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "aardvark",
  "rules": {
    "source_file": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": ".*?\\(language (aardvark|aascript)( \\d+\\.\\d+)?\\)"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        }
      ]
    },
    "comment": {
      "type": "CHOICE",
      "members": [
        {
          "type": "PATTERN",
          "value": ";;[^\\n]*"
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "STRING",
              "value": ";"
            },
            {
              "type": "SYMBOL",
              "name": "_form"
            }
          ]
        }
      ]
    },
    "_form": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "block"
        },
        {
          "type": "SYMBOL",
          "name": "call"
        },
        {
          "type": "SYMBOL",
          "name": "data"
        },
        {
          "type": "SYMBOL",
          "name": "lambda"
        },
        {
          "type": "SYMBOL",
          "name": "pair"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "symbol"
        }
      ]
    },
    "_form_not_dot": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_form"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "\\."
          },
          "named": true,
          "value": "symbol"
        }
      ]
    },
    "symbol": {
      "type": "PATTERN",
      "value": "(\\\\[\\[\\](){};:\\s\"\\\\]|[^\\[\\](){};:\\s\"\\\\])+"
    },
    "_lambda_content": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_form_not_dot"
            }
          },
          "named": true,
          "value": "parameters"
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "STRING",
              "value": "."
            }
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_lambda_content"
            },
            {
              "type": "ALIAS",
              "content": {
                "type": "REPEAT",
                "content": {
                  "type": "SYMBOL",
                  "name": "_form_not_dot"
                }
              },
              "named": true,
              "value": "body"
            }
          ]
        }
      ]
    },
    "lambda": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "SYMBOL",
          "name": "_lambda_content"
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_form_not_dot"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        }
      ]
    },
    "data": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        }
      ]
    },
    "call": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_form"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "pair": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": ":"
        },
        {
          "type": "SYMBOL",
          "name": "_form"
        },
        {
          "type": "SYMBOL",
          "name": "_form"
        }
      ]
    },
    "string": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "string_escape"
              },
              {
                "type": "PATTERN",
                "value": "[^\\\\\"]"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "string_escape": {
      "type": "PATTERN",
      "value": "\\\\[0abntr<>\\\\]"
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[+-]?\\d+(\\.\\d+(e[+-]?\\d+)?)?"
        }
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [
    {
      "type": "SYMBOL",
      "name": "long_string"
    },
    {
      "type": "SYMBOL",
      "name": "long_string_escape"
    }
  ],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}